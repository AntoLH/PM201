{
  "expo": {
    "name": "Usuarios UPQ",
    "slug": "usuarios-upq",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Logo_APK.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/Logo_APK.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.antoniolh.usuarios",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "62e1b29f-f7f8-41e0-ab67-e6d7d062907a"
      }
    }
  }
}
